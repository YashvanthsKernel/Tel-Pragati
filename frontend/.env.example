# Baghewala Digital Twin — Environment Variables
# Copy this file to .env.local for local development

# Backend API URL (replace with your deployed backend URL for production)
NEXT_PUBLIC_API_BASE_URL=https://your-backend-url.com/api/v1

# WebSocket backend URL
NEXT_PUBLIC_WS_BASE_URL=wss://your-backend-url.com/ws

# Data mode: "live" for real backend data, "demo" for mock/demo data
NEXT_PUBLIC_DEFAULT_DATA_MODE=demo

# CARTO Maps API Key (get one at https://carto.com)
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here
NEXT_PUBLIC_CARTO_USERNAME=your_carto_username
