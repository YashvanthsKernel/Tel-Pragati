# === Database ===
DATABASE_URL=postgresql+asyncpg://btwin:secret@localhost:5432/btwin
DATABASE_URL_SYNC=postgresql://btwin:secret@localhost:5432/btwin

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === MQTT ===
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=btwin-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# === Auth ===
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=baghewala-digital-twin

# === App ===
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

# === Synthetic Data ===
USE_SYNTHETIC_DATA=true
SYNTHETIC_TICK_INTERVAL_S=5

# === Oil Pricing (INR) ===
OIL_PRICE_PER_BBL_INR=7000
ENERGY_TARIFF_INR_PER_KWH=8.5
STEAM_COST_INR_PER_TON=1200
